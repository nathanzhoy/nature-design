<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.nathan.widget.ui.view.NatureEditText
        android:id="@+id/edit_text_normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="?marginSpecific"
        android:background="@drawable/na_bg_edit_text"
        android:hint="@string/app_name"
        android:imeOptions="actionDone"
        app:layout_constraintBottom_toTopOf="@id/edit_text_pwd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.nathan.widget.ui.view.NatureEditText
        android:id="@+id/edit_text_pwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="?marginSpecific"
        android:background="@drawable/na_bg_edit_text"
        android:inputType="numberPassword"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_text_normal" />

</androidx.constraintlayout.widget.ConstraintLayout>