<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--<com.nathan.widget.SmoothCornerLayout
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:radius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:background="@android:color/holo_red_dark"
            android:src="@mipmap/ic_launcher"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.nathan.widget.SmoothCornerLayout>-->

    <TextView
        android:id="@+id/tv"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_button"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="平滑圆角"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:visibility="invisible"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:cardCornerRadius="100dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@android:color/holo_red_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv"/>


    <com.nathan.widget.SmoothCornerLayout
        android:id="@+id/tv_container"
        android:radius="20dp"
        android:translationZ="100dp"
        android:layout_width="200dp"
        android:layout_height="100dp"
        app:layout_constraintStart_toStartOf="@id/card"
        app:layout_constraintEnd_toEndOf="@id/card"
        app:layout_constraintTop_toTopOf="@id/card">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/holo_blue_dark"
            android:padding="10dp"
            android:textSize="12sp"
            android:text="正确用法是：确保通过obtainStyledAttributes() 并传入正确的参数，让系统在构造 TypedArray 时就完成属性解析，而不是把解析工作留给后续的 get 方法。是因为遇到崩溃了才在看这段源码吗？可以发一下你的具体代码，我帮你看一下问题出在哪儿。"
            android:textColor="@color/white" />

    </com.nathan.widget.SmoothCornerLayout>

    <com.nathan.widget.SmoothCornerLayout
        android:radius="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_container"
        android:layout_width="100dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="100dp">

        <ImageView
            android:src="@drawable/ic_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </com.nathan.widget.SmoothCornerLayout>

</androidx.constraintlayout.widget.ConstraintLayout>