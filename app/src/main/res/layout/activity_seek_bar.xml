<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.nathan.widget.ui.view.NatureSeekBar
        android:id="@+id/seek_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="?marginMedium"
        android:progress="20"
        app:layout_constraintBottom_toTopOf="@id/increase_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/increase_progress"
        style="@style/Widget.Nature.Button.Fix.Red"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="增加进度"
        app:layout_constraintBottom_toTopOf="@id/btn_disable"
        app:layout_constraintEnd_toStartOf="@id/decrease_progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seek_bar" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/decrease_progress"
        style="@style/Widget.Nature.Button.Fix.Green"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="减少进度"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/increase_progress"
        app:layout_constraintTop_toTopOf="@id/increase_progress" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/btn_disable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/disable_switch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/increase_progress" />

</androidx.constraintlayout.widget.ConstraintLayout>