<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.nathan.widget.ui.view.NatureForwardingButton
        android:id="@+id/btn_forwarding_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/na_ic_circle_close"
        android:text="@string/button"
        app:layout_constraintBottom_toTopOf="@id/btn_forwarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.nathan.widget.ui.view.NatureForwardingButton
        android:id="@+id/btn_forwarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button"
        app:layout_constraintBottom_toTopOf="@id/btn_not_forwarding_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_forwarding_icon" />

    <com.nathan.widget.ui.view.NatureForwardingButton
        android:id="@+id/btn_not_forwarding_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/na_ic_emoji_smile"
        android:text="@string/button"
        app:isForwarding="false"
        app:layout_constraintBottom_toTopOf="@id/btn_not_forwarding"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_forwarding" />

    <com.nathan.widget.ui.view.NatureForwardingButton
        android:id="@+id/btn_not_forwarding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button"
        app:isForwarding="false"
        app:layout_constraintBottom_toTopOf="@id/btn_disable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_not_forwarding_icon" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/btn_disable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/disable_switch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_not_forwarding" />

</androidx.constraintlayout.widget.ConstraintLayout>