<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/common_dialog"
        app:layout_constraintBottom_toTopOf="@id/scroll_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/scroll_dialog"
        style="@style/Widget.Nature.Button.Fix.Orange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scrollable_dialog"
        app:layout_constraintBottom_toTopOf="@id/single_list_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dialog" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/single_list_dialog"
        style="@style/Widget.Nature.Button.Fix.Blue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/single_list_dialog"
        app:layout_constraintBottom_toTopOf="@id/multi_list_dialog"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scroll_dialog" />

    <com.nathan.widget.ui.view.NatureButton
        android:id="@+id/multi_list_dialog"
        style="@style/Widget.Nature.Button.Fix.Green"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/multi_list_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/single_list_dialog" />


</androidx.constraintlayout.widget.ConstraintLayout>