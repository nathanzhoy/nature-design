<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 通用图标 -->
    <attr name="natureIcon" format="reference" />
    <!-- 通用小图标 -->
    <attr name="natureIconSmall" format="reference" />

    <!-- 平滑圆角布局样式声明 -->
    <attr name="natureSmoothCornerLayoutStyle" format="reference" />
    <declare-styleable name="NatureSmoothCornerLayout">
        <attr name="android:radius" />
        <attr name="android:color" />
    </declare-styleable>

    <!-- 平滑圆角Drawable样式声明 -->
    <declare-styleable name="SmoothCornerDrawable">
        <attr name="android:radius" />
        <attr name="android:color" />
    </declare-styleable>

    <attr name="natureButtonStyle" format="reference" />
    <declare-styleable name="NatureButton" />

    <attr name="natureToolbarStyle" format="reference" />
    <declare-styleable name="NatureToolbar">

    </declare-styleable>

    <attr name="natureListItemViewStyle" format="reference" />
    <declare-styleable name="NatureListItemView">
        <attr name="android:title" />
        <attr name="android:summary" />
        <attr name="mode" format="enum">
            <enum name="custom" value="0" />
            <enum name="toggle" value="1" />
            <enum name="dot" value="2" />
            <enum name="number" value="3" />
        </attr>
        <!-- 自定义布局 -->
        <attr name="android:layout" />
        <attr name="avatar" format="reference" />
        <attr name="tip" format="reference" />
    </declare-styleable>

    <attr name="natureEditTextStyle" format="reference" />
    <declare-styleable name="NatureEditText">
        <attr name="showClear" format="boolean" />
        <attr name="android:text" />
        <attr name="android:hint" />
        <attr name="android:imeOptions" />
        <attr name="android:imeActionId" />
        <attr name="android:imeActionLabel" />
        <attr name="android:inputType" />
        <attr name="android:maxLines" />
    </declare-styleable>

    <attr name="natureButtonToggleGroupStyle" format="reference" />
    <declare-styleable name="NatureButtonToggleGroup">
        <attr name="singleSelection" />
        <attr name="selectionRequired" />
        <attr name="android:enabled" />
        <attr name="android:checkedButton" />
    </declare-styleable>
</resources>