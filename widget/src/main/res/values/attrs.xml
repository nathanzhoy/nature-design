<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 平滑圆角布局样式声明 -->
    <attr name="smoothCornerLayout" format="reference" />
    <declare-styleable name="SmoothCornerLayout">
        <attr name="android:radius" />
        <attr name="android:color" />
    </declare-styleable>

    <!-- 平滑圆角Drawable样式声明 -->
    <declare-styleable name="SmoothCornerDrawable">
        <attr name="android:radius" />
        <attr name="android:color" />
    </declare-styleable>

    <attr name="button" format="reference" />
    <declare-styleable name="NatureButton" />
</resources>