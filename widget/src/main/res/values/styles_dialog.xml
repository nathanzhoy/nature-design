<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Nature.AlertDialog" parent="MaterialAlertDialog.MaterialComponents">
        <!--<item name="listLayout">@layout/fa_select_dialog_list</item>-->
        <item name="android:layout">@layout/na_alert_dialog</item>
        <!--<item name="multiChoiceItemLayout">@layout/fa_dialog_item_with_check_box</item>
        <item name="singleChoiceItemLayout">@layout/fa_dialog_item_with_check_text</item>
        <item name="android:maxHeight">@dimen/fa_dialog_alert_max_height</item>-->
    </style>

    <style name="Widget.Nature.Dialog.Button.Positive" parent="Widget.Nature.Button">
        <item name="android:background">@drawable/na_bg_dialog_btn_positive</item>
        <item name="android:textColor">?colorOnPrimary</item>
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
    </style>
    <style name="Widget.Nature.Dialog.Button.Negative" parent="Widget.Nature.Button">
        <item name="android:background">@drawable/na_bg_dialog_btn_negative</item>
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
    </style>


    <style name="Theme.Nature.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <!-- Primary -->
        <item name="colorPrimary">@color/na_primary</item>
        <item name="colorPrimaryContainer">@color/na_primary_container</item>
        <item name="colorOnPrimary">@color/na_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/na_on_primary_container</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/na_secondary</item>
        <item name="colorSecondaryContainer">@color/na_secondary_container</item>
        <item name="colorOnSecondary">@color/na_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/na_on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/na_tertiary</item>
        <item name="colorTertiaryContainer">@color/na_tertiary_container</item>
        <item name="colorOnTertiary">@color/na_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/na_on_tertiary_container</item>

        <!-- Error -->
        <item name="colorError">@color/na_error</item>
        <item name="colorErrorContainer">@color/na_error_container</item>
        <item name="colorOnError">@color/na_on_error</item>
        <item name="colorOnErrorContainer">@color/na_on_error_container</item>

        <!-- Fixed -->
        <item name="colorPrimaryFixed">@color/na_primary_fixed</item>
        <item name="colorPrimaryFixedDim">@color/na_primary_fixed_dim</item>
        <item name="colorSecondaryFixed">@color/na_secondary_fixed</item>
        <item name="colorSecondaryFixedDim">@color/na_secondary_fixed_dim</item>
        <item name="colorTertiaryFixed">@color/na_tertiary_fixed</item>
        <item name="colorTertiaryFixedDim">@color/na_tertiary_fixed_dim</item>

        <!-- On Fixed -->
        <item name="colorOnPrimaryFixed">@color/na_on_primary_fixed</item>
        <item name="colorOnSecondaryFixed">@color/na_on_secondary_fixed</item>
        <item name="colorOnTertiaryFixed">@color/na_on_tertiary_fixed</item>
        <item name="colorOnPrimaryFixedVariant">@color/na_on_primary_fixed_variant</item>
        <item name="colorOnSecondaryFixedVariant">@color/na_on_secondary_fixed_variant</item>
        <item name="colorOnTertiaryFixedVariant">@color/na_on_tertiary_fixed_variant</item>

        <!-- Surface -->
        <item name="colorSurfaceDim">@color/na_surface_dim</item>
        <item name="colorSurface">@color/na_surface</item>
        <item name="colorSurfaceBright">@color/na_surface_bright</item>
        <item name="colorSurfaceContainer">@color/na_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/na_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/na_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/na_surface_container_highest</item>

        <!-- Inverse -->
        <item name="colorInverseSurface">@color/na_inverse_surface</item>
        <item name="colorInverseOnSurface">@color/na_inverse_on_surface</item>
        <item name="colorInversePrimary">@color/na_inverse_primary</item>

        <!-- On Surface -->
        <item name="colorOnSurface">@color/na_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/na_on_surface_variant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/na_outline</item>
        <item name="colorOutlineVariant">@color/na_outline_variant</item>

        <!-- Misc -->
        <item name="colorScrim">@color/na_scrim</item>
        <item name="colorShadow">@color/na_shadow</item>

        <!-- Lowest / Highest -->
        <item name="colorLowest">@color/na_lowest</item>
        <item name="colorHighest">@color/na_highest</item>

        <!-- Colorful -->
        <item name="colorPrimaryRed">@color/na_primary_red</item>
        <item name="colorOnPrimaryRed">@color/na_on_primary_red</item>
        <item name="colorPrimaryContainerRed">@color/na_primary_container_red</item>
        <item name="colorOnPrimaryContainerRed">@color/na_on_primary_container_red</item>
        <item name="colorPrimaryGreen">@color/na_primary_green</item>
        <item name="colorOnPrimaryGreen">@color/na_on_primary_green</item>
        <item name="colorPrimaryContainerGreen">@color/na_primary_container_green</item>
        <item name="colorOnPrimaryContainerGreen">@color/na_on_primary_container_green</item>
        <item name="colorPrimaryYellow">@color/na_primary_yellow</item>
        <item name="colorOnPrimaryYellow">@color/na_on_primary_yellow</item>
        <item name="colorPrimaryContainerYellow">@color/na_primary_container_yellow</item>
        <item name="colorOnPrimaryContainerYellow">@color/na_on_primary_container_yellow</item>
        <item name="colorPrimaryOrange">@color/na_primary_orange</item>
        <item name="colorOnPrimaryOrange">@color/na_on_primary_orange</item>
        <item name="colorPrimaryContainerOrange">@color/na_primary_container_orange</item>

        <!-- alertDialogStyle以及button，因为被AlertDialog类wrapper过，导致Theme层alertDialogStyle失效，统一放这里 -->
        <item name="alertDialogStyle">@style/Widget.Nature.AlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Nature.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Nature.Dialog.Button.Negative</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="windowMinWidthMajor">50%</item>
        <item name="windowMinWidthMinor">90%</item>
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="dialogPreferredPadding">18dp</item>
        <item name="android:backgroundDimAmount">0.8</item>
    </style>

    <!--白天模式Dialog 颜色style-->
    <style name="Theme.Nature.Dialog.DayNight" parent="Theme.Nature.Dialog" />

    <style name="Theme.Nature.Dialog.Alert" parent="Theme.Nature.Dialog.DayNight">

    </style>
</resources>