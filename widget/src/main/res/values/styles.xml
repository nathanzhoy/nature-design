<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Nature" parent="" />


    <style name="Widget.Nature.Icon">
        <item name="android:layout_width">25dp</item>
        <item name="android:layout_height">25dp</item>
    </style>
    <!-- 通用小图标样式 -->
    <style name="Widget.Nature.Icon.Small">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
    </style>

    <!-- 平滑圆角布局样式 -->
    <style name="Widget.Nature.SmoothCornerLayout" parent="">
        <item name="android:radius">?cornerSmall</item>
    </style>

    <!-- 标题栏 -->
    <style name="Widget.Nature.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/na_bg_toolbar</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="titleTextAppearance">?textAppearanceTitleMedium</item>
        <item name="subtitleTextAppearance">?textAppearanceBodyLarge</item>
        <item name="paddingStart">10dp</item>
        <item name="buttonGravity">center_vertical</item>
        <item name="paddingEnd">10dp</item>
        <item name="contentInsetStart">20dp</item>
        <item name="contentInsetEnd">20dp</item>
        <item name="titleMargins">0dp</item>
        <item name="navigationIcon">@drawable/na_ic_back</item>
    </style>

    <!-- 标题栏返回按钮 -->
    <style name="Widget.Nature.NavigationIcon" parent="Widget.Material3.Search.Toolbar.Button.Navigation">
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:background">@null</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- 列表 -->
    <style name="Widget.Nature.ListItemView">
        <item name="android:background">@drawable/na_bg_list_item_view</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- 输入框 -->
    <style name="Widget.Nature.EditText">
        <item name="android:background">@drawable/na_bg_edit_text</item>
        <item name="android:maxLines">1</item>
        <item name="showClear">true</item>
    </style>

    <style name="Widget.Nature.ButtonToggleGroup">
        <item name="android:gravity">center</item>
        <item name="android:padding">?marginMini</item>
        <item name="android:background">@drawable/na_bg_btn_toggle_group</item>
        <item name="selectionRequired">true</item>
        <item name="singleSelection">true</item>
    </style>

    <style name="Widget.Nature.Switch">
        <item name="android:thumb">@drawable/na_bg_switch_thumb</item>
        <item name="track">@drawable/na_bg_switch_tracker</item>
        <item name="showText">false</item>
        <item name="android:clickable">true</item>
        <item name="android:textOn">@string/lib_name</item>
        <item name="android:textOff">@string/lib_name</item>
    </style>

    <style name="Widget.Nature.CheckedTextView">
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:background">@drawable/na_bg_dialog_list_item</item>
        <item name="android:paddingVertical">?marginMini</item>
        <item name="android:paddingHorizontal">?marginMedium</item>
        <item name="android:textAppearance">?textAppearanceBodyLarge</item>
        <item name="android:textColor">@color/na_dialog_list_item_text_color</item>
        <item name="android:checkMark">@drawable/na_bg_dialog_list_item_check_mark</item>
        <item name="android:checkMarkTint">?colorPrimary</item>
    </style>

    <style name="Widget.Nature.SeekBar">
        <item name="android:minHeight">20dp</item>
        <item name="android:enabled">true</item>
        <item name="android:clickable">true</item>
        <item name="android:padding">?marginMini</item>
        <item name="android:background">@drawable/na_bg_seek_bar</item>
        <item name="android:progressDrawable">@drawable/na_bg_seek_bar_progress</item>
    </style>
</resources>