<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">


    <com.nathan.widget.ui.view.NatureSmoothCornerLayout
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:radius="?cornerMini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            tools:src="@drawable/na_ic_left_arrow"
            tools:visibility="visible" />

    </com.nathan.widget.ui.view.NatureSmoothCornerLayout>

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?textAppearanceBodyLarge"
        android:textColor="?colorOnSurface"
        app:layout_constraintBottom_toTopOf="@android:id/summary"
        app:layout_constraintStart_toEndOf="@id/avatar_container"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/lib_name" />

    <ImageView
        android:id="@+id/tip"
        style="?natureIconSmall"
        android:layout_marginStart="10dp"
        android:src="@drawable/na_ic_info"
        app:layout_constraintBottom_toBottomOf="@android:id/title"
        app:layout_constraintStart_toEndOf="@android:id/title"
        app:layout_constraintTop_toTopOf="@android:id/title"
        app:tint="?colorOnSurfaceVariant" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?textAppearanceLabelLarge"
        android:textColor="?colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@android:id/title"
        app:layout_constraintTop_toBottomOf="@android:id/title"
        tools:text="@string/lib_name"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/extra_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:ellipsize="end"
        android:maxWidth="100dp"
        android:maxLines="1"
        android:textAppearance="?textAppearanceLabelLarge"
        android:textColor="?colorOnSurfaceVariant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/custom_layout"
        app:layout_constraintEnd_toStartOf="@id/custom_layout"
        app:layout_constraintTop_toTopOf="@id/custom_layout"
        tools:text="@string/lib_name"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/custom_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="100dp"
        app:layout_constraintBottom_toBottomOf="@id/forwarding"
        app:layout_constraintEnd_toStartOf="@id/forwarding"
        app:layout_constraintTop_toTopOf="@id/forwarding" />

    <ImageView
        android:id="@+id/forwarding"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:padding="5dp"
        android:src="@drawable/na_ic_right_arrow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?colorOnSurfaceVariant" />

</merge>